document.addEventListener("DOMContentLoaded", function() {
    var table = document.querySelector(".field");
    var appendRowButton = document.querySelector(".append-row");
    var removeRowButton = document.querySelector(".remove-row");
    var appendColumnButton = document.querySelector(".append-column");
    var removeColumnButton = document.querySelector(".remove-column");
    var MAX_SIZE = 10;
    var MIN_SIZE = 2;
    // Function to update the buttons' state
    var updateButtonsState = function() {
        var rows = table.rows.length;
        var columns = table.rows[0].cells.length;
        // Disable or enable row buttons
        removeRowButton.disabled = rows <= MIN_SIZE;
        appendRowButton.disabled = rows >= MAX_SIZE;
        // Disable or enable column buttons
        removeColumnButton.disabled = columns <= MIN_SIZE;
        appendColumnButton.disabled = columns >= MAX_SIZE;
    };
    // Append a row to the table
    appendRowButton.addEventListener("click", function() {
        var newRow = table.insertRow();
        var columnCount = table.rows[0].cells.length;
        for(var i = 0; i < columnCount; i++)newRow.insertCell(); // No need to assign it to a variable
        updateButtonsState();
    });
    // Remove the last row from the table
    removeRowButton.addEventListener("click", function() {
        table.deleteRow(table.rows.length - 1);
        updateButtonsState();
    });
    // Append a column to each row
    appendColumnButton.addEventListener("click", function() {
        var rows = table.rows;
        for(var i = 0; i < rows.length; i++)rows[i].insertCell();
        updateButtonsState();
    });
    // Remove the last column from each row
    removeColumnButton.addEventListener("click", function() {
        var rows = table.rows;
        for(var i = 0; i < rows.length; i++)rows[i].deleteCell(rows[i].cells.length - 1);
        updateButtonsState();
    });
    // Initial state check
    updateButtonsState();
});

